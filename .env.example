# VeyMotion app configuration. Copy to .env and adjust.
# The app reads these from the environment, or from a .env file in the working directory (swift run),
# next to the app binary, or at ~/Library/Application Support/VeyMotion/.env.

# VeyMotion server (./server) that proxies VieNeu text-to-speech. The VieNeu API key lives in server/.env.
BASE_API_URL=http://localhost:3000
