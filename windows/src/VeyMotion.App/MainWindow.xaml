<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VeyMotion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:chat="using:VeyMotion.App.Chat"
    xmlns:editor="using:VeyMotion.App.Editor"
    Title="VeyMotion">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown" PreviewKeyUp="Root_PreviewKeyUp">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="New_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="Export_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="A" Invoked="Annotate_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="Open_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="Save_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="S" Invoked="SaveAs_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="Undo_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="Redo_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="Redo_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="S" Invoked="ToggleSidebar_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="I" Invoked="ToggleInspector_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="T" Invoked="ToggleTimeline_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="TimelineRow" Height="230" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <DropDownButton AutomationProperties.Name="File menu" ToolTipService.ToolTip="File">
                    <SymbolIcon Symbol="Page2" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="New Scene…" Click="New_Click" KeyboardAcceleratorTextOverride="Ctrl+N">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="New Project…" Click="NewProject_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewFolder" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open…" Click="Open_Click" KeyboardAcceleratorTextOverride="Ctrl+O">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open Project Folder…" Click="OpenFolder_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Folder" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Save" Click="Save_Click" KeyboardAcceleratorTextOverride="Ctrl+S">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Save As…" Click="SaveAs_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                            <MenuFlyoutItem Text="Publish Video…" Click="Publish_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export Video…" Click="Export_Click" KeyboardAcceleratorTextOverride="Ctrl+E">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ShowInExplorerItem" Text="Show in Explorer" Click="ShowInExplorer_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="UndoButton" Click="Undo_Click" IsEnabled="False">
                    <SymbolIcon Symbol="Undo" />
                </Button>
                <Button x:Name="RedoButton" Click="Redo_Click" IsEnabled="False">
                    <SymbolIcon Symbol="Redo" />
                </Button>
                <AppBarSeparator />
                <DropDownButton x:Name="AddButton" AutomationProperties.Name="Add menu" ToolTipService.ToolTip="Add a layer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </DropDownButton>
                <DropDownButton x:Name="LayerButton" AutomationProperties.Name="Layer menu" ToolTipService.ToolTip="The selected layer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81E;" />
                        <TextBlock Text="Layer" />
                    </StackPanel>
                </DropDownButton>
            </StackPanel>
            <TextBlock x:Name="SceneTitle" Grid.Column="1" VerticalAlignment="Center" Opacity="0.8" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="PipeStatus" VerticalAlignment="Center" FontSize="12" Opacity="0.55" Margin="0,0,6,0" />
                <ToggleButton x:Name="SidebarToggle" IsChecked="True" Click="PanelToggle_Click" ToolTipService.ToolTip="Layers (Ctrl+Alt+S)">
                    <FontIcon Glyph="&#xE8A0;" />
                </ToggleButton>
                <ToggleButton x:Name="TimelineToggle" IsChecked="True" Click="PanelToggle_Click" ToolTipService.ToolTip="Timeline (Ctrl+Alt+T)">
                    <FontIcon Glyph="&#xE81C;" />
                </ToggleButton>
                <ToggleButton x:Name="RightToggle" IsChecked="True" Click="PanelToggle_Click" ToolTipService.ToolTip="Inspector and Claude (Ctrl+Alt+I)">
                    <FontIcon Glyph="&#xE89F;" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Sidebar: layers -->
        <Border x:Name="SidebarHost" Grid.Row="1" Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4" Padding="10,8,10,0">
                    <ToggleButton x:Name="LayersTab" Content="Layers" IsChecked="True" Click="SidebarTab_Click" />
                    <ToggleButton x:Name="AssetsTab" Content="Assets" Click="SidebarTab_Click" />
                </StackPanel>
                <editor:LayersPanel x:Name="Layers" Grid.Row="1" />
                <editor:AssetsPanel x:Name="Assets" Grid.Row="1" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Canvas + transport -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <canvas:CanvasControl x:Name="Canvas" Draw="Canvas_Draw" ClearColor="#FF16161A" UseSharedDevice="True"
                                  PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved"
                                  PointerReleased="Canvas_PointerReleased" PointerCaptureLost="Canvas_PointerCaptureLost" />
            <Border x:Name="AnnotationBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                    Padding="6" CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel x:Name="AnnotationTools" Orientation="Horizontal" Spacing="4" />
            </Border>
            <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Click="Play_Click" ToolTipService.ToolTip="Play / Pause (Space, Enter)">
                    <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
                </Button>
                <Slider x:Name="Scrubber" Grid.Column="1" VerticalAlignment="Center" Minimum="0" StepFrequency="0.001"
                        IsThumbToolTipEnabled="False" ValueChanged="Scrubber_ValueChanged" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="TimeLabel" VerticalAlignment="Center" FontFamily="Consolas" />
                    <ToggleButton x:Name="AnnotateButton" AutomationProperties.Name="Annotate" Click="Annotate_Click" ToolTipService.ToolTip="Draw on the frame and send it to Claude (Ctrl+Shift+A)">
                        <FontIcon Glyph="&#xED63;" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: Inspector / Claude -->
        <Grid x:Name="RightHost" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" BorderThickness="1,0,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="10,8,10,4">
                <ToggleButton x:Name="InspectorTab" Content="Inspector" Click="Tab_Click" />
                <ToggleButton x:Name="ChatTab" IsChecked="True" Click="Tab_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ContentPresenter x:Name="ChatToggleLogo" VerticalAlignment="Center" />
                        <TextBlock Text="Claude" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <editor:InspectorPanel x:Name="Inspector" Grid.Row="1" Visibility="Collapsed" />
            <chat:ChatPanel x:Name="Chat" Grid.Row="1" />
        </Grid>

        <!-- Timeline -->
        <Border x:Name="TimelineHost" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <editor:TimelinePanel x:Name="Timeline" />
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Grid.ColumnSpan="3" Padding="12,3" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
