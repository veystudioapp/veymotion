<?xml version="1.0" encoding="utf-8"?>
<!-- Port of ChatPanel.swift + ChatComposer.swift. Transcript items are built in code (ChatPanel.xaml.cs) because they
     change while Claude streams. -->
<UserControl
    x:Class="VeyMotion.App.Chat.ChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="12,8" ColumnSpacing="8" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="HeaderLogo" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Claude" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button x:Name="VersionsButton" Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="The scene after each prompt to Claude" Click="VersionsButton_Click">
                <FontIcon Glyph="&#xE81C;" FontSize="14" />
            </Button>
            <Button Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="New conversation" Click="NewChat_Click">
                <FontIcon Glyph="&#xE70F;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Transcript -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemsPanel" Padding="12" Spacing="10" />
        </ScrollViewer>

        <!-- Composer -->
        <Border x:Name="ComposerBorder" Grid.Row="2" Margin="10" Padding="12,10,12,8" CornerRadius="10" BorderThickness="1"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                AllowDrop="True" DragOver="Composer_DragOver" DragLeave="Composer_DragLeave" Drop="Composer_Drop">
            <StackPanel Spacing="8">
                <ScrollViewer x:Name="AttachmentsScroller" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="AttachmentsPanel" Orientation="Horizontal" Spacing="6" Padding="0,4,4,0" />
                </ScrollViewer>

                <TextBox x:Name="InputBox" PlaceholderText="Ask Claude to animate something…" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" MaxHeight="200" Padding="0" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsSpellCheckEnabled="False"
                         TextChanged="InputBox_TextChanged" PreviewKeyDown="InputBox_PreviewKeyDown"
                         Paste="InputBox_Paste"
                         TextCompositionStarted="InputBox_TextCompositionStarted"
                         TextCompositionEnded="InputBox_TextCompositionEnded">
                    <TextBox.Resources>
                        <!-- Borderless, transparent field inside the rounded composer box. -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>

                <!-- Toolbar -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ModelButton" Padding="6,3" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Model and effort" Click="ModelButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ContentPresenter x:Name="ModelLogo" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModelLabel" FontSize="12" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Opacity="0.6" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Padding="4" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Attach images (or paste one with Ctrl+V, or drop files for their paths)"
                            Click="Attach_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Opacity="0.75" />
                    </Button>
                    <Button x:Name="SendButton" Grid.Column="3" Width="28" Height="28" Padding="0" CornerRadius="7"
                            Click="SendButton_Click">
                        <FontIcon x:Name="SendIcon" Glyph="&#xE74A;" FontSize="13" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
