# Copy to .env and fill in. Create a key at https://www.vieneu.io/#/developer
# Live keys start with vn_sk_, test keys with vn_test_ (max 100 words per request).
NITRO_VIENEU_API_KEY=

# Publishing to social platforms (optional; leave a platform empty to hide it in the app).
# Register <public URL>/api/social/<platform>/callback as the redirect URI in each developer console,
# e.g. http://localhost:3000/api/social/youtube/callback in development.
# Public address of this server as the platforms see it (defaults to the request's origin).
NITRO_SOCIAL_PUBLIC_URL=
# YouTube: Google Cloud console > OAuth client (Web application), YouTube Data API v3 enabled.
NITRO_SOCIAL_YOUTUBE_CLIENT_ID=
NITRO_SOCIAL_YOUTUBE_CLIENT_SECRET=
# TikTok: developers.tiktok.com app with Login Kit + Content Posting API (client key / secret).
# Without an approved video.publish scope, set NITRO_SOCIAL_TIKTOK_SCOPES=user.info.basic,video.upload
NITRO_SOCIAL_TIKTOK_CLIENT_ID=
NITRO_SOCIAL_TIKTOK_CLIENT_SECRET=
# Facebook Pages: developers.facebook.com app with Facebook Login (app id / app secret).
NITRO_SOCIAL_FACEBOOK_CLIENT_ID=
NITRO_SOCIAL_FACEBOOK_CLIENT_SECRET=
# X: developer.x.com app with OAuth 2.0 enabled as a confidential client (client id / secret).
NITRO_SOCIAL_X_CLIENT_ID=
NITRO_SOCIAL_X_CLIENT_SECRET=
